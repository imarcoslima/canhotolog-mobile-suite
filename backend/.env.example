# Copie este arquivo para ".env" e ajuste os valores para o seu ambiente.
# Os nomes das variáveis foram mantidos iguais aos já usados no config.php
# do CanhotoLog web, para reaproveitar a mesma configuração/infraestrutura.

# ------------------------------------------------------------------
# Servidor WebSocket
# ------------------------------------------------------------------
WS_PORT=8787
# Duração da sessão emitida no login (o app guarda o token e reautentica
# sozinho enquanto ele for válido; expirado, pede login de novo).
SESSION_TTL_HORAS=12
# Pasta onde as fotos das conferências de entrega são salvas — recomendado
# ser A MESMA pasta "uploads/" do CanhotoLog web, para as fotos aparecerem
# nos mesmos lugares (Painel, visualizar.php etc. podem ser estendidos para
# exibi-las; por enquanto elas ficam disponíveis para consulta direta).
UPLOAD_DIR=../../transporte/uploads

# ------------------------------------------------------------------
# Banco do próprio CanhotoLog (igual ao config.php do sistema web)
# ------------------------------------------------------------------
DB_DRIVER=sqlite
# Caminho do arquivo SQLite do CanhotoLog web — aponte para o MESMO arquivo
# que o config.php usa (SQLITE_PATH), para os dois sistemas lerem/gravarem
# os mesmos dados.
SQLITE_PATH=../../transporte/db/database.sqlite

# Usado somente quando DB_DRIVER=sqlsrv (mesmos valores do config.php):
SQLSRV_HOST=localhost
SQLSRV_DATABASE=transporte
SQLSRV_USER=sa
SQLSRV_PASSWORD=

# ------------------------------------------------------------------
# kitbase (banco separado, consultado no menu Descarga e agora também na
# conferência de etiquetas do Registrar Entrega)
# ------------------------------------------------------------------
KITBASE_HOST=10.1.1.2\SQL2012
KITBASE_DATABASE=KITBASE
KITBASE_USER=sa
KITBASE_PASSWORD=P@ssw0rd

# ------------------------------------------------------------------
# SAP Business One — Service Layer (HANA ou SQL Server, tanto faz: a
# Service Layer abstrai isso) — mesmos valores do config.php
# ------------------------------------------------------------------
SAP_B1_SERVICE_LAYER_URL=https://b1.ativy.com:50000/b1s/v1
SAP_B1_COMPANY_DB=SBO_3PKIT_PROD
SAP_B1_USER=manager
SAP_B1_PASSWORD=kit@1234
SAP_B1_VERIFICAR_SSL=1
SAP_B1_NF_RESOURCE=Invoices
SAP_B1_NF_QUERY=?$select=DocEntry,DocNum,DocDate,CardName,Serial&$orderby=DocDate%20desc&$top=200
SAP_B1_CAMPO_NUMERO_NF=Serial
SAP_B1_CAMPO_DATA_EMISSAO=DocDate
SAP_B1_CAMPO_CLIENTE=CardName
