{
  "name": "canhotolog-mobile-backend",
  "version": "0.1.0",
  "private": true,
  "description": "Backend WebSocket do CanhotoLog Mobile — ponte entre o app (Android/iOS) e o banco do CanhotoLog + kitbase + SAP B1 Service Layer.",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc",
    "start": "node dist/index.js",
    "dev": "ts-node-dev --respawn --transpile-only src/index.ts",
    "typecheck": "tsc --noEmit"
  },
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "better-sqlite3": "^13.0.3",
    "dotenv": "^17.4.2",
    "mssql": "^12.7.0",
    "uuid": "^14.0.2",
    "ws": "^8.21.3"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/better-sqlite3": "^9.6.0",
    "@types/mssql": "^12.3.0",
    "@types/node": "^26.5.0",
    "@types/uuid": "^10.0.0",
    "@types/ws": "^8.18.1",
    "ts-node-dev": "^2.0.0",
    "typescript": "^7.0.2"
  }
}
